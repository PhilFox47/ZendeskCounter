{
  "manifest_version": 3,
  "name": "Zendesk Productivity Tracker",
  "version": "1.2.0",
  "description": "Tracks your Zendesk productivity — solved/hr and replies/hr per 30-minute block — and shows both rates right on the toolbar icon.",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["*://*.zendesk.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Zendesk Productivity Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

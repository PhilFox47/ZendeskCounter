{
  "manifest_version": 3,
  "name": "Ticket Telemetry",
  "version": "1.9.0",
  "description": "Tracks your Zendesk solved/hr and replies/hr per 30-minute block — shown on the toolbar icon and a full timeline dashboard.",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["*://*.zendesk.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Ticket Telemetry",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
